{
  "name": "video-speeds",
  "version": "0.1.0",
  "description": "Video Speed Controller for YouTube and RuTube — speed buttons, slider, hotkeys, diagnostics. Bilingual (EN/RU).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.0.293",
    "@vitest/ui": "^2.1.9",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-monkey": "^5.0.8",
    "vitest": "^2.1.9",
    "web-ext": "^8.10.0",
    "wxt": "^0.19.27"
  }
}
